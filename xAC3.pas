unit xAC3;

{$mode objfpc}{$H+}

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
// Description:	AC-3 and E-AC-3 (Dolby Digital, Dolby Digital Plus,           //
//		ATSC A/52 and Annex E) decoder for TXelAudio                  //
//		Raw .ac3 / .eac3 streams; tracks in MP4 are handled by xM4A.  //
//		All channel modes, LFE, coupling, rematrixing, block          //
//		switching, dither, dynamic range control; E-AC-3 adaptive     //
//		hybrid transform and spectral extension. Output is downmixed  //
//		to stereo (Lo/Ro), mono streams stay mono. E-AC-3 decodes the //
//		first independent substream (5.1 of a 7.1 stream).            //
// Version:	0.2                                                           //
// Date:	01-OCT-2026                                                   //
// License:     MIT                                                           //
// Target:	Win64, Free Pascal                                            //
// Copyright:	(c) 2026 Xelitan.com.                                         //
//		All rights reserved.                                          //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

interface

uses Classes, SysUtils, Types, Math, xAudioBase;

type
  EAc3Error = class(Exception);

  { TAc3Decoder - decodes AC-3 sync frames (1536 samples per channel) }

  TAc3Decoder = class
  private
    // bit reader
    FData: PByte;
    FPos, FEnd: Integer;
    // frame header
    FSampleRate, FFscod, FBsid, FAcmod, FNfchans, FChannels, FFrameSize: Integer;
    FLfeOn: Boolean;
    FLfeCh: Integer;
    FCmixLev, FSurMixLev: Double;
    // block state (index 0 = coupling channel, 1..5 full bandwidth, LFE after them)
    FBlkSw, FDithFlag, FChInCpl: array[0..6] of Boolean;
    FDynRng: array[0..1] of Double;
    FCplInUse, FPhsFlgInUse: Boolean;
    FNumCplBands: Integer;
    FCplBandSize: array[0..17] of Integer;
    FCplCo: array[0..6, 0..17] of Double;
    FPhsFlg: array[0..17] of Boolean;
    FNumRematBands: Integer;
    FRematFlg: array[0..3] of Boolean;
    FExpStr: array[0..6] of Integer;
    FStartF, FEndF, FNumGrps: array[0..6] of Integer;
    FExps: array[0..6, 0..255] of Integer;
    FSDecay, FFDecay, FSGain, FDbKnee, FFloor: Integer;
    FSnrOffset, FFastGain: array[0..6] of Integer;
    FCplFLeak, FCplSLeak: Integer;
    FDbaMode, FDbaNSegs: array[0..6] of Integer;
    FDbaOffset, FDbaLength, FDbaValue: array[0..6, 0..7] of Integer;
    FPsd: array[0..6, 0..255] of Integer;
    FBndPsd, FMask: array[0..6, 0..49] of Integer;
    FBap: array[0..6, 0..255] of Byte;
    FCoef: array[0..6, 0..255] of Single;
    // mantissa groups
    FB1, FB2, FB4: Integer;
    FB1Mant, FB2Mant: array[0..1] of Single;
    FB4Mant: Single;
    // synthesis
    FDelay: array[0..6, 0..255] of Single;
    FOutput: array of Single;   // interleaved, native channel order
    FRand: Cardinal;
    // syntax flags (fixed for AC-3, per frame for E-AC-3)
    FEac3: Boolean;
    FNumBlocks, FStrmTyp, FSubstreamId: Integer;
    FBlkSwSyntax, FDithSyntax, FBitAllocSyntax, FFastGainSyntax, FDbaSyntax, FSkipSyntax: Boolean;
    FSnrOffsetStrategy: Integer;
    // E-AC-3 frame data
    FCplStrategyExists, FCplInUseBlk: array[0..5] of Boolean;
    FExpStrBlk: array[0..5, 0..6] of Integer;
    FUsesAht: array[0..6] of Boolean;
    FFirstCplCoords, FFirstSpxCoords: array[0..6] of Boolean;
    FFirstCplLeak: Boolean;
    FCplBandStruct: array[0..18] of Boolean;
    FSpxInUse: Boolean;
    FChUsesSpx: array[0..6] of Boolean;
    FSpxAttenCode: array[0..6] of Integer;
    FSpxDstStart, FSpxSrcStart, FSpxDstEnd, FNumSpxBands: Integer;
    FSpxBandSize: array[0..16] of Integer;
    FSpxBandStruct: array[0..18] of Boolean;
    FSpxNoiseBlend, FSpxSignalBlend: array[0..6, 0..16] of Single;
    FPreMant: array[0..6, 0..255, 0..5] of Integer;

    function GetBits(N: Integer): Integer;
    function Get1: Boolean;
    procedure ParseHeader;
    procedure ParseAudioFrame;
    procedure BandStructure(Blk, StartSub, EndSub: Integer; Spx: Boolean;
      var NumBands: Integer; var Sizes: array of Integer);
    procedure SpxStrategy(Blk: Integer);
    procedure SpxCoordinates;
    procedure ApplySpx;
    procedure DecodeAht(Ch: Integer);
    procedure DecodeChannel(Ch, Blk: Integer);
    procedure CouplingStrategy(Blk: Integer);
    procedure DecodeBlock(Blk: Integer);
    procedure DecodeExponents(Ch, AbsExp, Start: Integer);
    procedure BitAllocation(Ch: Integer);
    procedure DecodeMantissas(Ch: Integer);
    procedure Imdct(Ch, Blk: Integer);
  public
    constructor Create;
    { size in bytes of the AC-3 or E-AC-3 frame starting at Data (0 if none) }
    class function FrameLength(Data: PByte; Len: Integer): Integer;
    { decodes one sync frame; returns the samples per channel (256 per block,
      1536 for AC-3) stored in Output (interleaved, channel order L C R Ls Rs
      LFE as in the stream), or 0 for E-AC-3 frames of other substreams }
    function DecodeFrame(Data: PByte; Len: Integer): Integer;
    procedure OutputSilence;
    { mixes the decoded frame to Dest: 1 channel for mono, else stereo (Lo/Ro) }
    function Downmix(var Dest: TSingleDynArray; var Count: Int64): Integer;
    function Output: PSingle;
    property Channels: Integer read FChannels;
    property SampleRate: Integer read FSampleRate;
    property Acmod: Integer read FAcmod;
    property LfeOn: Boolean read FLfeOn;
  end;

  { TAudioAC3 }

  TAudioAC3 = class(TAudioBase)
  public
    function LoadFromStream(Str: TStream): Boolean; override;
  end;

{ Decodes a raw AC-3 or E-AC-3 stream. Native = True keeps all channels
  (stream order), otherwise the result is mono or stereo. }
function DecodeAC3(Str: TStream; out Samples: TSingleDynArray;
  out Channels, SampleRate: Integer; Native: Boolean = False): Boolean;

