  DynRngTab: array[0..255] of Double;
  // IMDCT via DCT-IV and complex FFT (sizes 128 and 64)
  TwPre, TwPost: array[0..1, 0..127] of record Re, Im: Single; end;
  FftCs, FftSn: array[0..1, 0..63] of Single;
  BitRev: array[0..1, 0..127] of Word;
  TablesReady: Boolean = False;

function BesselI0(X: Double): Double;
var Sum, Term, K: Double;
begin
  Sum := 1;
  Term := 1;
  K := 1;
  repeat
    Term := Term * Sqr(X / (2 * K));
    Sum := Sum + Term;
    K := K + 1;
  until Term < 1e-12 * Sum;
  Result := Sum;
end;

procedure InitTables;
var i, j, s, M, H, Bits: Integer;
    W: array[0..256] of Double;
    Total, Acc: Double;
begin
  if TablesReady then Exit;
  // Kaiser-Bessel derived window, alpha = 5, length 512
  Total := 0;
  for i:=0 to 256 do begin
    W[i] := BesselI0(Pi * 5 * Sqrt(Max(0, 1 - Sqr((i - 128) / 128))));
    Total := Total + W[i];
  end;
  Acc := 0;
  for i:=0 to 255 do begin
    Acc := Acc + W[i];
    Window[i] := Sqrt(Acc / Total);
    Window[511 - i] := Window[i];
  end;
  // dynamic range gain words: (1.YYYYY) * 2^X, X = signed 3 bit exponent
  for i:=0 to 255 do
    DynRngTab[i] := Power(2, (i shr 5) - ((i shr 7) shl 3) - 5) * ((i and $1F) or $20);
  // M = 256 (long) and 128 (short) coefficients: FFT sizes 128, 64
  for s:=0 to 1 do begin
    if s = 0 then M := 256 else M := 128;
    H := M div 2;
    for i:=0 to H-1 do begin
      TwPre[s, i].Re := Cos(Pi*(i + 0.25)/M);  TwPre[s, i].Im := -Sin(Pi*(i + 0.25)/M);
      TwPost[s, i].Re := Cos(Pi*i/M);          TwPost[s, i].Im := -Sin(Pi*i/M);
    end;
    for i:=0 to H div 2 - 1 do begin
      FftCs[s, i] := Cos(2*Pi*i/H);
      FftSn[s, i] := -Sin(2*Pi*i/H);
    end;
    Bits := 0;
    while (1 shl Bits) < H do Inc(Bits);
    for i:=0 to H-1 do begin
      BitRev[s, i] := 0;
      for j:=0 to Bits-1 do
        if (i shr j) and 1 <> 0 then BitRev[s, i] := BitRev[s, i] or (1 shl (Bits-1-j));
    end;
  end;
  TablesReady := True;
end;

procedure Fft(Re, Im: PSingle; N, S: Integer);
var i, j, Len, Half, Step, k: Integer;
    TRe, TIm, WRe, WIm, URe, UIm: Single;
begin
  for i:=0 to N-1 do begin
    j := BitRev[S, i];
    if j > i then begin
      TRe := Re[i]; Re[i] := Re[j]; Re[j] := TRe;
      TIm := Im[i]; Im[i] := Im[j]; Im[j] := TIm;
    end;
  end;
  Len := 2;
  while Len <= N do begin
    Half := Len div 2;
    Step := N div Len;
    i := 0;
    while i < N do begin
      for k:=0 to Half-1 do begin
        WRe := FftCs[S, k*Step];
        WIm := FftSn[S, k*Step];
        j := i + k + Half;
        TRe := Re[j]*WRe - Im[j]*WIm;
        TIm := Re[j]*WIm + Im[j]*WRe;
        URe := Re[i+k];
        UIm := Im[i+k];
        Re[i+k] := URe + TRe;
        Im[i+k] := UIm + TIm;
        Re[j] := URe - TRe;
        Im[j] := UIm - TIm;
      end;
      Inc(i, Len);
    end;
    Len := Len * 2;
  end;
end;

{ y[n] = sum_k X[k] cos(2pi/N (n + n0)(k + 1/2)), N = 2M, n0 = N/4 + 1/2 }
procedure ImdctStd(X: PSingle; M: Integer; Dest: PSingle);
var Re, Im: array[0..127] of Single;
    Y: array[0..255] of Single;
    k, n, H, S: Integer;
    a, b, c, d: Single;
begin
  H := M div 2;
  if M = 256 then S := 0 else S := 1;
  for k:=0 to H-1 do begin
    a := X[2*k];
    b := X[M-1-2*k];
    c := TwPre[S, k].Re; d := TwPre[S, k].Im;
    Re[k] := a*c - b*d;
    Im[k] := a*d + b*c;
  end;
  Fft(@Re[0], @Im[0], H, S);
  for k:=0 to H-1 do begin
    c := TwPost[S, k].Re; d := TwPost[S, k].Im;
    a := Re[k]*c - Im[k]*d;
    b := Re[k]*d + Im[k]*c;
    Y[2*k] := a;
    Y[M-1-2*k] := -b;
  end;
  for n:=0 to H-1 do Dest[n] := Y[n + H];
  for n:=H to 3*H-1 do Dest[n] := -Y[3*H-1-n];
  for n:=3*H to 2*M-1 do Dest[n] := -Y[n-3*H];
end;

{ TAc3Decoder }

constructor TAc3Decoder.Create;
begin
  inherited Create;
  InitTables;
  FRand := $12345678;
end;

function TAc3Decoder.GetBits(N: Integer): Integer;
var i: Integer;
begin
  if FPos + N > FEnd then raise EAc3Error.Create('AC-3 frame truncated');
  Result := 0;
  for i:=1 to N do begin
    Result := (Result shl 1) or ((FData[FPos shr 3] shr (7 - (FPos and 7))) and 1);
    Inc(FPos);
  end;
end;

function TAc3Decoder.Get1: Boolean;
begin
  Result := GetBits(1) <> 0;
end;

class function TAc3Decoder.FrameLength(Data: PByte; Len: Integer): Integer;
var Fscod, Frmsizecod, Bsid: Integer;
begin
  Result := 0;
  if (Len < 6) or (Data[0] <> $0B) or (Data[1] <> $77) then Exit;
  Bsid := Data[5] shr 3;
  if Bsid <= 10 then begin
    Fscod := Data[4] shr 6;
    Frmsizecod := Data[4] and $3F;
    if (Fscod = 3) or (Frmsizecod > 37) then Exit;
    Result := 2 * Ac3FrameSize[Frmsizecod, Fscod];
  end
  else if Bsid <= 16 then
    Result := 2 * ((((Data[2] and 7) shl 8) or Data[3]) + 1);
end;

procedure TAc3Decoder.ParseHeader;
var Frmsizecod, i, n, Bsid: Integer;
begin
  if GetBits(16) <> $0B77 then raise EAc3Error.Create('AC-3 sync word missing');
  Bsid := (FData[5] shr 3) and 31;
  FCmixLev := CenterLevels[1];
  FSurMixLev := SurroundLevels[1];
  if Bsid <= 10 then begin
    // AC-3
    FEac3 := False;
    FStrmTyp := 2;
    FSubstreamId := 0;
    FNumBlocks := 6;
    GetBits(16);                    // crc1
    FFscod := GetBits(2);
    Frmsizecod := GetBits(6);
    if (FFscod = 3) or (Frmsizecod > 37) then raise EAc3Error.Create('Invalid AC-3 frame header');
    FBsid := GetBits(5);
    if FBsid > 8 then raise EAc3Error.Create('Reduced sample rate AC-3 is not supported');
    FSampleRate := Ac3SampleRates[FFscod];
    FFrameSize := 2 * Ac3FrameSize[Frmsizecod, FFscod];
    GetBits(3);                     // bsmod
    FAcmod := GetBits(3);
    if FAcmod = 2 then GetBits(2)   // dsurmod
    else begin
      if (FAcmod and 1 <> 0) and (FAcmod <> 1) then FCmixLev := CenterLevels[GetBits(2)];
      if FAcmod and 4 <> 0 then FSurMixLev := SurroundLevels[GetBits(2)];
    end;
    FLfeOn := Get1;
    for i:=0 to Ord(FAcmod = 0) do begin
      GetBits(5);                   // dialnorm
      if Get1 then GetBits(8);      // compr
      if Get1 then GetBits(8);      // langcod
      if Get1 then GetBits(7);      // mixlevel, roomtyp
    end;
    GetBits(2);                     // copyrightb, origbs
    if Get1 then GetBits(14);       // timecod1 / xbsi1
    if Get1 then GetBits(14);       // timecod2 / xbsi2
    if Get1 then begin              // addbsi
      n := GetBits(6);
      GetBits(8 * (n + 1));
    end;
    FBlkSwSyntax := True; FDithSyntax := True; FBitAllocSyntax := True;
    FFastGainSyntax := False; FDbaSyntax := True; FSkipSyntax := True;
    FSnrOffsetStrategy := 2;
    FFirstCplLeak := False;
    for i:=0 to 6 do FUsesAht[i] := False;
  end
  else if Bsid <= 16 then begin
    // E-AC-3 (A/52 Annex E)
    FEac3 := True;
    FStrmTyp := GetBits(2);
    FSubstreamId := GetBits(3);
    FFrameSize := (GetBits(11) + 1) * 2;
    FFscod := GetBits(2);
    if FFscod = 3 then raise EAc3Error.Create('Reduced sample rate E-AC-3 is not supported');
    FNumBlocks := Eac3Blocks[GetBits(2)];
    FSampleRate := Ac3SampleRates[FFscod];
    FAcmod := GetBits(3);
    FLfeOn := Get1;
    FBsid := GetBits(5);
    if FStrmTyp = 3 then raise EAc3Error.Create('Invalid E-AC-3 stream type');
    FCmixLev := GainLevels[5];
    FSurMixLev := GainLevels[6];
    for i:=0 to Ord(FAcmod = 0) do begin
      GetBits(5);                   // dialnorm
      if Get1 then GetBits(8);      // compr
    end;
    if FStrmTyp = 1 then
      if Get1 then GetBits(16);     // chanmap
    if Get1 then begin              // mixing metadata
      if FAcmod > 2 then begin
        GetBits(2);                 // dmixmod
        if FAcmod and 1 <> 0 then begin
          GetBits(3);               // ltrtcmixlev
          FCmixLev := GainLevels[GetBits(3)];
        end;
        if FAcmod and 4 <> 0 then begin
          GetBits(3);               // ltrtsurmixlev
          FSurMixLev := GainLevels[EnsureRange(GetBits(3), 3, 7)];
        end;
      end;
      if FLfeOn then
        if Get1 then GetBits(5);    // lfemixlevcod
      if FStrmTyp = 0 then begin
        for i:=0 to Ord(FAcmod = 0) do
          if Get1 then GetBits(6);  // pgmscl
        if Get1 then GetBits(6);    // extpgmscl
        case GetBits(2) of          // mixdef
          1: GetBits(5);
          2: GetBits(12);
          3: begin
            n := (GetBits(5) + 2) * 8;
            if FPos + n > FEnd then raise EAc3Error.Create('E-AC-3 frame truncated');
            Inc(FPos, n);
          end;
        end;
        if FAcmod < 2 then
          for i:=0 to Ord(FAcmod = 0) do
            if Get1 then GetBits(14); // panmean, paninfo
        if Get1 then                // frmmixcfginfoe
          for i:=0 to FNumBlocks-1 do
            if (FNumBlocks = 1) or Get1 then GetBits(5);
      end;
    end;
    if Get1 then begin              // informational metadata
      GetBits(3);                   // bsmod
      GetBits(2);                   // copyrightb, origbs
      if FAcmod = 2 then GetBits(4);
      if FAcmod >= 6 then GetBits(2);
      for i:=0 to Ord(FAcmod = 0) do
        if Get1 then GetBits(8);
      GetBits(1);                   // sourcefscod
    end;
    if (FStrmTyp = 0) and (FNumBlocks <> 6) then GetBits(1); // convsync
    if FStrmTyp = 2 then
      if (FNumBlocks = 6) or Get1 then GetBits(6);           // frmsizecod
    if Get1 then begin              // addbsi
      n := GetBits(6);
      GetBits(8 * (n + 1));
    end;
  end
  else raise EAc3Error.Create('Unsupported AC-3 bitstream id');

  FNfchans := Ac3ChanCount[FAcmod];
  FChannels := FNfchans + Ord(FLfeOn);
  if FLfeOn then FLfeCh := FNfchans + 1 else FLfeCh := -1;
  if FLfeOn then begin
    FStartF[FLfeCh] := 0;
    FEndF[FLfeCh] := 7;
    FNumGrps[FLfeCh] := 2;
    FChInCpl[FLfeCh] := False;
  end;
end;

procedure TAc3Decoder.DecodeExponents(Ch, AbsExp, Start: Integer);
var g, i, j, GrpSize, Code, Prev: Integer;
    D: array[0..2] of Integer;
begin
  GrpSize := 3 shl (FExpStr[Ch] - 1) div 3;   // 1, 2, 4
  Prev := AbsExp;
  j := Start;
  for g:=0 to FNumGrps[Ch]-1 do begin
    Code := GetBits(7);
    if Code >= 125 then raise EAc3Error.Create('Invalid AC-3 exponent group');
    D[0] := Code div 25;
    D[1] := (Code mod 25) div 5;
    D[2] := Code mod 5;
    for i:=0 to 2 do begin
      Inc(Prev, D[i] - 2);
      if (Prev < 0) or (Prev > 24) then raise EAc3Error.Create('Invalid AC-3 exponent');
      if j + GrpSize > 256 then raise EAc3Error.Create('Invalid AC-3 exponent count');
      case GrpSize of
        1: FExps[Ch, j] := Prev;
        2: begin FExps[Ch, j] := Prev; FExps[Ch, j+1] := Prev; end;
        else begin FExps[Ch, j] := Prev; FExps[Ch, j+1] := Prev; FExps[Ch, j+2] := Prev; FExps[Ch, j+3] := Prev; end;
      end;
      Inc(j, GrpSize);
    end;
  end;
end;

{ bit allocation (A/52 7.2.2) }
procedure TAc3Decoder.BitAllocation(Ch: Integer);

  function CalcLowComp1(A, B0, B1, C: Integer): Integer;
  begin
    Result := A;
    if B0 + 256 = B1 then Result := C
    else if B0 > B1 then Result := Max(A - 64, 0);
  end;

  function CalcLowComp(A, B0, B1, Bin: Integer): Integer;
  begin
    if Bin < 7 then Result := CalcLowComp1(A, B0, B1, 384)
    else if Bin < 20 then Result := CalcLowComp1(A, B0, B1, 320)
    else Result := Max(A - 128, 0);
  end;

var Start, End_, Bin, Band, BandEnd, V, Mx, Adr, BandStart, BandEndX, Begin_, End1: Integer;
    LowComp, FastLeak, SlowLeak, FGain, Seg, Delta, i, Msk, Address, Snr: Integer;
    IsLfe: Boolean;
    Excite: array[0..49] of Integer;
    BapTab: PByte;
begin
  if FUsesAht[Ch] then BapTab := @Eac3HebapTab[0] else BapTab := @Ac3BapTab[0];
  Start := FStartF[Ch];
  End_ := FEndF[Ch];
  if End_ <= Start then begin
    FillChar(FBap[Ch], SizeOf(FBap[Ch]), 0);
    Exit;
  end;
  IsLfe := Ch = FLfeCh;
  FGain := FFastGain[Ch];

  // exponents -> power spectral density, integrated per band
  for Bin:=Start to End_-1 do FPsd[Ch, Bin] := 3072 - (FExps[Ch, Bin] shl 7);
  Bin := Start;
  while (Bin < End_) and (Bin < 28) do begin
    FBndPsd[Ch, Bin] := FPsd[Ch, Bin];
    Inc(Bin);
  end;
  if Bin < End_ then begin
    Band := Ac3BinToBand[Bin];
    repeat
      V := FPsd[Ch, Bin];
      Inc(Bin);
      BandEnd := Min(Ac3BandStart[Band + 1], End_);
      while Bin < BandEnd do begin
        Mx := Max(V, FPsd[Ch, Bin]);
        Adr := Min(Mx - ((V + FPsd[Ch, Bin] + 1) shr 1), 255);
        V := Mx + Ac3LogAdd[Adr];
        Inc(Bin);
      end;
      FBndPsd[Ch, Band] := V;
      Inc(Band);
    until End_ <= Ac3BandStart[Band];
  end;

  // excitation
  BandStart := Ac3BinToBand[Start];
  BandEndX := Ac3BinToBand[End_ - 1] + 1;
  if BandStart = 0 then begin
    LowComp := 0;
    LowComp := CalcLowComp1(LowComp, FBndPsd[Ch, 0], FBndPsd[Ch, 1], 384);
    Excite[0] := FBndPsd[Ch, 0] - FGain - LowComp;
    LowComp := CalcLowComp1(LowComp, FBndPsd[Ch, 1], FBndPsd[Ch, 2], 384);
    Excite[1] := FBndPsd[Ch, 1] - FGain - LowComp;
    Begin_ := 7;
    FastLeak := 0;
    SlowLeak := 0;
    for Band:=2 to 6 do begin
      if not (IsLfe and (Band = 6)) then
        LowComp := CalcLowComp1(LowComp, FBndPsd[Ch, Band], FBndPsd[Ch, Band+1], 384);
      FastLeak := FBndPsd[Ch, Band] - FGain;
      SlowLeak := FBndPsd[Ch, Band] - FSGain;
      Excite[Band] := FastLeak - LowComp;
      if not (IsLfe and (Band = 6)) then
        if FBndPsd[Ch, Band] <= FBndPsd[Ch, Band+1] then begin
          Begin_ := Band + 1;
          Break;
        end;
    end;
    End1 := Min(BandEndX, 22);
    for Band:=Begin_ to End1-1 do begin
      if not (IsLfe and (Band = 6)) then
        LowComp := CalcLowComp(LowComp, FBndPsd[Ch, Band], FBndPsd[Ch, Band+1], Band);
      FastLeak := Max(FastLeak - FFDecay, FBndPsd[Ch, Band] - FGain);
      SlowLeak := Max(SlowLeak - FSDecay, FBndPsd[Ch, Band] - FSGain);
      Excite[Band] := Max(FastLeak - LowComp, SlowLeak);
    end;
    Begin_ := 22;
  end
  else begin
    // coupling channel
    Begin_ := BandStart;
    FastLeak := (FCplFLeak shl 8) + 768;
    SlowLeak := (FCplSLeak shl 8) + 768;
  end;
  for Band:=Begin_ to BandEndX-1 do begin
    FastLeak := Max(FastLeak - FFDecay, FBndPsd[Ch, Band] - FGain);
    SlowLeak := Max(SlowLeak - FSDecay, FBndPsd[Ch, Band] - FSGain);
    Excite[Band] := Max(FastLeak, SlowLeak);
  end;

  // masking curve
  for Band:=BandStart to BandEndX-1 do begin
    i := FDbKnee - FBndPsd[Ch, Band];
    if i > 0 then Inc(Excite[Band], i shr 2);
    FMask[Ch, Band] := Max(Ac3Hth[Band, FFscod], Excite[Band]);
  end;

  // delta bit allocation
  if (FDbaMode[Ch] = DBA_REUSE) or (FDbaMode[Ch] = DBA_NEW) then begin
    Band := BandStart;
    for Seg:=0 to FDbaNSegs[Ch]-1 do begin
      Inc(Band, FDbaOffset[Ch, Seg]);
      if (Band >= 50) or (FDbaLength[Ch, Seg] > 50 - Band) then raise EAc3Error.Create('Invalid AC-3 delta bit allocation');
      if FDbaValue[Ch, Seg] >= 4 then Delta := (FDbaValue[Ch, Seg] - 3) * 128
      else Delta := (FDbaValue[Ch, Seg] - 4) * 128;
      for i:=0 to FDbaLength[Ch, Seg]-1 do begin
        Inc(FMask[Ch, Band], Delta);
        Inc(Band);
      end;
    end;
  end;

  // bit allocation pointers
  Snr := FSnrOffset[Ch];
  if Snr = -960 then begin
    FillChar(FBap[Ch], SizeOf(FBap[Ch]), 0);
    Exit;
  end;
  Bin := Start;
  while (Bin < End_) and (Bin < 28) do begin
    Msk := (Max(FMask[Ch, Bin] - Snr - FFloor, 0) and $1FE0) + FFloor;
    Address := EnsureRange(SarLongint(FPsd[Ch, Bin] - Msk, 5), 0, 63);
    FBap[Ch, Bin] := BapTab[Address];
    Inc(Bin);
  end;
  if Bin < End_ then begin
    Band := Ac3BinToBand[Bin];
    repeat
      Msk := (Max(FMask[Ch, Band] - Snr - FFloor, 0) and $1FE0) + FFloor;
      Inc(Band);
      BandEnd := Min(Ac3BandStart[Band], End_);
      while Bin < BandEnd do begin
        Address := EnsureRange(SarLongint(FPsd[Ch, Bin] - Msk, 5), 0, 63);
        FBap[Ch, Bin] := BapTab[Address];
        Inc(Bin);
      end;
    until End_ <= BandEnd;
  end;
end;

procedure TAc3Decoder.DecodeMantissas(Ch: Integer);
var Bin, Bap, Code, Q, V: Integer;
    Mant: Single;
    Dither: Boolean;
begin
  Dither := (Ch = 0) or FDithFlag[Ch];
  for Bin:=FStartF[Ch] to FEndF[Ch]-1 do begin
    Bap := FBap[Ch, Bin];
    case Bap of
      0:
        if Dither then begin
          // uniform random noise of about -0.707 .. 0.707
          FRand := Cardinal(QWord(FRand) * 1664525 + 1013904223);
          Mant := ((FRand shr 8) / 16777216 - 0.5) * 1.41421356;
        end
        else Mant := 0;
      1:
        if FB1 > 0 then begin
          Dec(FB1);
          Mant := FB1Mant[FB1];
        end
        else begin
          Code := GetBits(5);
          if Code > 26 then raise EAc3Error.Create('Invalid AC-3 mantissa');
          Mant := (Code div 9 - 1) * 2 / 3;
          FB1Mant[1] := ((Code mod 9) div 3 - 1) * 2 / 3;
          FB1Mant[0] := (Code mod 3 - 1) * 2 / 3;
          FB1 := 2;
        end;
      2:
        if FB2 > 0 then begin
          Dec(FB2);
          Mant := FB2Mant[FB2];
        end
        else begin
          Code := GetBits(7);
          if Code > 124 then raise EAc3Error.Create('Invalid AC-3 mantissa');
          Mant := (Code div 25 - 2) * 2 / 5;
          FB2Mant[1] := ((Code mod 25) div 5 - 2) * 2 / 5;
          FB2Mant[0] := (Code mod 5 - 2) * 2 / 5;
          FB2 := 2;
        end;
      3: begin
        Code := GetBits(3);
        if Code > 6 then raise EAc3Error.Create('Invalid AC-3 mantissa');
        Mant := (Code - 3) * 2 / 7;
      end;
      4:
        if FB4 > 0 then begin
          FB4 := 0;
          Mant := FB4Mant;
        end
        else begin
          Code := GetBits(7);
          if Code > 120 then raise EAc3Error.Create('Invalid AC-3 mantissa');
          Mant := (Code div 11 - 5) * 2 / 11;
          FB4Mant := (Code mod 11 - 5) * 2 / 11;
          FB4 := 1;
        end;
      5: begin
        Code := GetBits(4);
        if Code > 14 then raise EAc3Error.Create('Invalid AC-3 mantissa');
        Mant := (Code - 7) * 2 / 15;
      end;
      else begin
        Q := QuantBits[Bap];
        V := GetBits(Q);
        if V >= 1 shl (Q - 1) then Dec(V, 1 shl Q);
        Mant := V / (1 shl (Q - 1));
      end;
    end;
    FCoef[Ch, Bin] := Mant * Power(2, -FExps[Ch, Bin]);
  end;
end;

procedure TAc3Decoder.Imdct(Ch, Blk: Integer);
var X, X1, X2: array[0..255] of Single;
    Y: array[0..511] of Single;
    S1, S2: array[0..255] of Single;
    n, k, Idx, Stride: Integer;
    Pcm: PSingle;
begin
  if FBlkSw[Ch] and (Ch <= FNfchans) then begin
    // two 256 sample transforms: even and odd coefficients
    for k:=0 to 127 do begin
      X1[k] := FCoef[Ch, 2*k];
      X2[k] := FCoef[Ch, 2*k + 1];
    end;
    ImdctStd(@X1[0], 128, @S1[0]);   // n0 = 64.5
    ImdctStd(@X2[0], 128, @S2[0]);
    // first transform: n0 = 1/2 (shift -64), second: n0 = 128.5 (shift +64)
    for n:=0 to 255 do begin
      Idx := n - 64;
      if Idx < 0 then Y[n] := S1[Idx + 256] else Y[n] := -S1[Idx];
      Idx := n + 64;
      if Idx >= 256 then Y[256 + n] := S2[Idx - 256] else Y[256 + n] := -S2[Idx];
    end;
  end
  else begin
    for k:=0 to 255 do X[k] := FCoef[Ch, k];
    ImdctStd(@X[0], 256, @Y[0]);
    for n:=0 to 511 do Y[n] := -Y[n];
  end;
  Stride := FChannels;
  Pcm := @FOutput[(Blk * 256) * Stride + (Ch - 1)];
  for n:=0 to 255 do begin
    Pcm^ := 2 * (Y[n] * Window[n] + FDelay[Ch, n]);
    Inc(Pcm, Stride);
    FDelay[Ch, n] := Y[256 + n] * Window[256 + n];
  end;
end;

{ E-AC-3 audio frame: syntax flags and per-frame strategies (A/52 E.1.2.3) }
procedure TAc3Decoder.ParseAudioFrame;
var AcExpStr, ParseAht, ParseTransient, ParseSpxAtten, UseAht: Boolean;
    Blk, Ch, NumCplBlocks, Code, Bits, Csnr, Snr: Integer;
begin
  if FNumBlocks = 6 then begin
    AcExpStr := Get1;
    ParseAht := Get1;
  end
  else begin
    AcExpStr := True;
    ParseAht := False;
  end;
  FSnrOffsetStrategy := GetBits(2);
  ParseTransient := Get1;
  FBlkSwSyntax := Get1;
  if not FBlkSwSyntax then
    for Ch:=0 to 6 do FBlkSw[Ch] := False;
  FDithSyntax := Get1;
  if not FDithSyntax then
    for Ch:=1 to FNfchans do FDithFlag[Ch] := True;
  FDithFlag[0] := False;
  if FLfeOn then FDithFlag[FLfeCh] := False;
  FBitAllocSyntax := Get1;
  if not FBitAllocSyntax then begin
    FSDecay := Ac3SlowDecay[2];
    FFDecay := Ac3FastDecay[1];
    FSGain := Ac3SlowGain[1];
    FDbKnee := Ac3DbPerBit[2];
    FFloor := Ac3Floor[7];
  end;
  FFastGainSyntax := Get1;
  FDbaSyntax := Get1;
  FSkipSyntax := Get1;
  ParseSpxAtten := Get1;

  // coupling use per block
  NumCplBlocks := 0;
  for Blk:=0 to FNumBlocks-1 do begin
    if FAcmod > 1 then begin
      FCplStrategyExists[Blk] := (Blk = 0) or Get1;
      if FCplStrategyExists[Blk] then FCplInUseBlk[Blk] := Get1
      else FCplInUseBlk[Blk] := FCplInUseBlk[Blk-1];
    end
    else begin
      FCplStrategyExists[Blk] := False;
      FCplInUseBlk[Blk] := False;
    end;
    if FCplInUseBlk[Blk] then Inc(NumCplBlocks);
  end;

  // exponent strategies
  if AcExpStr then begin
    for Blk:=0 to FNumBlocks-1 do
      for Ch:=Ord(not FCplInUseBlk[Blk]) to FNfchans do FExpStrBlk[Blk, Ch] := GetBits(2);
  end
  else
    for Ch:=Ord(not ((FAcmod > 1) and (NumCplBlocks > 0))) to FNfchans do begin
      Code := GetBits(5);
      for Blk:=0 to 5 do FExpStrBlk[Blk, Ch] := Eac3FrmExpStr[Code, Blk];
    end;
  if FLfeOn then
    for Blk:=0 to FNumBlocks-1 do FExpStrBlk[Blk, FLfeCh] := GetBits(1);
  // converter exponent strategies
  if (FStrmTyp = 0) and ((FNumBlocks = 6) or Get1) then GetBits(5 * FNfchans);

  // adaptive hybrid transform
  for Ch:=0 to 6 do FUsesAht[Ch] := False;
  if ParseAht then
    for Ch:=Ord(NumCplBlocks <> 6) to FChannels do begin
      UseAht := True;
      for Blk:=1 to 5 do
        if (FExpStrBlk[Blk, Ch] <> EXP_REUSE) or ((Ch = 0) and FCplStrategyExists[Blk]) then begin
          UseAht := False;
          Break;
        end;
      FUsesAht[Ch] := UseAht and Get1;
    end;

  // per-frame SNR offset
  if FSnrOffsetStrategy = 0 then begin
    Csnr := (GetBits(6) - 15) shl 4;
    Snr := (Csnr + GetBits(4)) shl 2;
    for Ch:=0 to FChannels do FSnrOffset[Ch] := Snr;
  end;

  // transient pre-noise processing (not applied)
  if ParseTransient then
    for Ch:=1 to FNfchans do
      if Get1 then GetBits(18);

  // spectral extension attenuation
  for Ch:=1 to FNfchans do
    if ParseSpxAtten and Get1 then FSpxAttenCode[Ch] := GetBits(5)
    else FSpxAttenCode[Ch] := -1;

  // block start information
  if (FNumBlocks > 1) and Get1 then begin
    Bits := 0;
    while (2 shl Bits) <= FFrameSize - 2 do Inc(Bits);   // floor(log2(frame size - 2))
    Bits := (FNumBlocks - 1) * (4 + Bits);
    if FPos + Bits > FEnd then raise EAc3Error.Create('E-AC-3 frame truncated');
    Inc(FPos, Bits);
  end;

  for Ch:=1 to FNfchans do begin
    FFirstSpxCoords[Ch] := True;
    FFirstCplCoords[Ch] := True;
  end;
  FFirstCplLeak := True;
end;

{ band structure of coupling or spectral extension: subbands of 12 bins,
  a set flag merges a subband with the previous one }
procedure TAc3Decoder.BandStructure(Blk, StartSub, EndSub: Integer; Spx: Boolean;
  var NumBands: Integer; var Sizes: array of Integer);
var Sub, NSub: Integer;
    Struct: PBoolean;
begin
  NSub := EndSub - StartSub;
  if Spx then Struct := @FSpxBandStruct[0] else Struct := @FCplBandStruct[0];
  if Blk = 0 then
    for Sub:=0 to 17 do
      if Spx then Struct[Sub] := (Sub < 17) and (Eac3DefSpxBandStruct[Min(Sub, 16)] <> 0)
      else Struct[Sub] := Eac3DefCplBandStruct[Sub] <> 0;
  if (not FEac3) or Get1 then
    for Sub:=0 to NSub-2 do Struct[StartSub + 1 + Sub] := Get1;
  NumBands := 0;
  for Sub:=0 to NSub-1 do
    if (Sub > 0) and Struct[StartSub + Sub] then Inc(Sizes[NumBands - 1], 12)
    else begin
      Sizes[NumBands] := 12;
      Inc(NumBands);
    end;
end;

procedure TAc3Decoder.SpxStrategy(Blk: Integer);
var Ch, Bits, StartSub, EndSub, DstStart: Integer;
begin
  if FAcmod = 1 then FChUsesSpx[1] := True
  else begin
    Bits := GetBits(FNfchans);
    for Ch:=FNfchans downto 1 do begin
      FChUsesSpx[Ch] := Bits and 1 <> 0;
      Bits := Bits shr 1;
    end;
  end;
  DstStart := GetBits(2);
  StartSub := GetBits(3) + 2;
  if StartSub > 7 then StartSub := StartSub + StartSub - 7;
  EndSub := GetBits(3) + 5;
  if EndSub > 7 then EndSub := EndSub + EndSub - 7;
  FSpxDstStart := DstStart * 12 + 25;
  FSpxSrcStart := StartSub * 12 + 25;
  FSpxDstEnd := EndSub * 12 + 25;
  if (StartSub >= EndSub) or (FSpxDstStart >= FSpxSrcStart) then
    raise EAc3Error.Create('Invalid E-AC-3 spectral extension range');
  BandStructure(Blk, StartSub, EndSub, True, FNumSpxBands, FSpxBandSize);
end;

procedure TAc3Decoder.SpxCoordinates;
var Ch, Bnd, Bin, BandSize, Mstr, CoExp, CoMant: Integer;
    Blend, NRatio, NBlend, SBlend, Coord: Double;
begin
  for Ch:=1 to FNfchans do
    if FChUsesSpx[Ch] then begin
      if FFirstSpxCoords[Ch] or Get1 then begin
        FFirstSpxCoords[Ch] := False;
        Blend := GetBits(5) / 32;
        Mstr := GetBits(2) * 3;
        Bin := FSpxSrcStart;
        for Bnd:=0 to FNumSpxBands-1 do begin
          BandSize := FSpxBandSize[Bnd];
          NRatio := EnsureRange((Bin + BandSize div 2) / FSpxDstEnd - Blend, 0, 1);
          NBlend := Sqrt(3 * NRatio);   // noise is scaled by sqrt(3) for unity variance
          SBlend := Sqrt(1 - NRatio);
          Inc(Bin, BandSize);
          CoExp := GetBits(4);
          CoMant := GetBits(2);
          if CoExp = 15 then CoMant := CoMant shl 1 else Inc(CoMant, 4);
          Coord := CoMant * Power(2, 2 - CoExp - Mstr);
          FSpxNoiseBlend[Ch, Bnd] := NBlend * Coord;
          FSpxSignalBlend[Ch, Bnd] := SBlend * Coord;
        end;
      end;
    end
    else FFirstSpxCoords[Ch] := True;
end;

procedure TAc3Decoder.ApplySpx;
var Ch, Bnd, Bin, i, NumCopy, CopySize, BandSize: Integer;
    CopySizes: array[0..17] of Integer;
    Wrap: array[0..16] of Boolean;
    Rms: array[0..16] of Single;
    Acc, NScale, SScale: Double;
    C: PSingle;
begin
  // copy sections from the normal bands to the extension bands
  Bin := FSpxDstStart;
  NumCopy := 0;
  for Bnd:=0 to FNumSpxBands-1 do begin
    BandSize := FSpxBandSize[Bnd];
    Wrap[Bnd] := False;
    if Bin + BandSize > FSpxSrcStart then begin
      CopySizes[NumCopy] := Bin - FSpxDstStart;
      Inc(NumCopy);
      Bin := FSpxDstStart;
      Wrap[Bnd] := True;
    end;
    i := 0;
    while i < BandSize do begin
      if Bin = FSpxSrcStart then begin
        CopySizes[NumCopy] := Bin - FSpxDstStart;
        Inc(NumCopy);
        Bin := FSpxDstStart;
      end;
      CopySize := Min(BandSize - i, FSpxSrcStart - Bin);
      Inc(Bin, CopySize);
      Inc(i, CopySize);
    end;
  end;
  CopySizes[NumCopy] := Bin - FSpxDstStart;
  Inc(NumCopy);

  for Ch:=1 to FNfchans do begin
    if not FChUsesSpx[Ch] then Continue;
    Bin := FSpxSrcStart;
    for i:=0 to NumCopy-1 do begin
      Move(FCoef[Ch, FSpxDstStart], FCoef[Ch, Bin], CopySizes[i] * SizeOf(Single));
      Inc(Bin, CopySizes[i]);
    end;
    // RMS energy of each band
    Bin := FSpxSrcStart;
    for Bnd:=0 to FNumSpxBands-1 do begin
      Acc := 0;
      for i:=0 to FSpxBandSize[Bnd]-1 do begin
        Acc := Acc + Sqr(Double(FCoef[Ch, Bin]));
        Inc(Bin);
      end;
      Rms[Bnd] := Sqrt(Acc / FSpxBandSize[Bnd]);
    end;
    // notch filter at the transitions and wrap points
    if FSpxAttenCode[Ch] >= 0 then begin
      Bin := FSpxSrcStart - 2;
      for Bnd:=0 to FNumSpxBands-1 do begin
        if Wrap[Bnd] then begin
          C := @FCoef[Ch, Bin];
          C[0] := C[0] * Eac3SpxAtten[FSpxAttenCode[Ch], 0];
          C[1] := C[1] * Eac3SpxAtten[FSpxAttenCode[Ch], 1];
          C[2] := C[2] * Eac3SpxAtten[FSpxAttenCode[Ch], 2];
          C[3] := C[3] * Eac3SpxAtten[FSpxAttenCode[Ch], 1];
          C[4] := C[4] * Eac3SpxAtten[FSpxAttenCode[Ch], 0];
        end;
        Inc(Bin, FSpxBandSize[Bnd]);
      end;
    end;
    // noise blended scaling
    Bin := FSpxSrcStart;
    for Bnd:=0 to FNumSpxBands-1 do begin
      NScale := FSpxNoiseBlend[Ch, Bnd] * Rms[Bnd];
      SScale := FSpxSignalBlend[Ch, Bnd];
      for i:=0 to FSpxBandSize[Bnd]-1 do begin
        FRand := Cardinal(QWord(FRand) * 1664525 + 1013904223);
        FCoef[Ch, Bin] := FCoef[Ch, Bin] * SScale + NScale * (LongInt(FRand) / 2147483648.0);
        Inc(Bin);
      end;
    end;
  end;
end;

{ adaptive hybrid transform mantissas of all six blocks (A/52 E.3.4) }
procedure TAc3Decoder.DecodeAht(Ch: Integer);

  procedure Idct6(var M: array of Integer);
  const C0 = 10273905; C1 = 11863283; C2 = 3070444;
  var Tmp, Even0, Even1, Even2, Odd0, Odd1, Odd2: Int64;
  begin
    Odd1 := Int64(M[1]) - M[3] - M[5];
    Even2 := SarInt64(Int64(M[2]) * C0, 23);
    Tmp := SarInt64(Int64(M[4]) * C1, 23);
    Odd0 := SarInt64((Int64(M[1]) + M[5]) * C2, 23);
    Even0 := M[0] + SarInt64(Tmp, 1);
    Even1 := M[0] - Tmp;
    Tmp := Even0;
    Even0 := Tmp + Even2;
    Even2 := Tmp - Even2;
    Tmp := Odd0;
    Odd0 := Tmp + M[1] + M[3];
    Odd2 := Tmp + M[5] - M[3];
    M[0] := Even0 + Odd0;
    M[1] := Even1 + Odd1;
    M[2] := Even2 + Odd2;
    M[3] := Even2 - Odd2;
    M[4] := Even1 - Odd1;
    M[5] := Even0 - Odd0;
  end;

  function SBits(N: Integer): Integer;
  begin
    Result := GetBits(N);
    if Result >= 1 shl (N - 1) then Dec(Result, 1 shl N);
  end;

  function VqEntry(Hebap, V, Blk: Integer): Integer;
  begin
    case Hebap of
      1: Result := Eac3Vq1[V, Blk];
      2: Result := Eac3Vq2[V, Blk];
      3: Result := Eac3Vq3[V, Blk];
      4: Result := Eac3Vq4[V, Blk];
      5: Result := Eac3Vq5[V, Blk];
      6: Result := Eac3Vq6[V, Blk];
      else Result := Eac3Vq7[V, Blk];
    end;
  end;

var Bin, Blk, Gs, EndBap, GaqMode, Hebap, Bits, GBits, LogGain, MBits, Mant, B, Gc, Code: Integer;
    Gain: array[0..255] of Integer;
    M: array[0..5] of Integer;
begin
  GaqMode := GetBits(2);
  if GaqMode < 2 then EndBap := 12 else EndBap := 17;
  Gs := 0;
  if (GaqMode = 1) or (GaqMode = 2) then begin
    for Bin:=FStartF[Ch] to FEndF[Ch]-1 do
      if (FBap[Ch, Bin] > 7) and (FBap[Ch, Bin] < EndBap) then begin
        Gain[Gs] := GetBits(1) shl (GaqMode - 1);
        Inc(Gs);
      end;
  end
  else if GaqMode = 3 then begin
    Gc := 2;
    for Bin:=FStartF[Ch] to FEndF[Ch]-1 do
      if (FBap[Ch, Bin] > 7) and (FBap[Ch, Bin] < 17) then begin
        if Gc = 2 then begin
          Code := Min(GetBits(5), 26);
          Gain[Gs] := Code div 9;
          Gain[Gs + 1] := (Code mod 9) div 3;
          Gain[Gs + 2] := Code mod 3;
          Inc(Gs, 3);
          Gc := 0;
        end
        else Inc(Gc);
      end;
  end;

  Gs := 0;
  for Bin:=FStartF[Ch] to FEndF[Ch]-1 do begin
    Hebap := FBap[Ch, Bin];
    Bits := Eac3BitsVsHebap[Hebap];
    if Hebap = 0 then
      for Blk:=0 to 5 do begin
        FRand := Cardinal(QWord(FRand) * 1664525 + 1013904223);
        M[Blk] := Integer((FRand shr 8) and $7FFFFF) - $400000;
      end
    else if Hebap < 8 then begin
      Code := GetBits(Bits);
      for Blk:=0 to 5 do M[Blk] := VqEntry(Hebap, Code, Blk) * 256;
    end
    else begin
      if (GaqMode <> 0) and (Hebap < EndBap) then begin
        LogGain := Gain[Gs];
        Inc(Gs);
      end
      else LogGain := 0;
      GBits := Bits - LogGain;
      for Blk:=0 to 5 do begin
        Mant := SBits(GBits);
        if (LogGain <> 0) and (Mant = -(1 shl (GBits - 1))) then begin
          // large mantissa
          MBits := Bits - (2 - LogGain);
          Mant := SBits(MBits);
          Mant := Mant * (1 shl (23 - (MBits - 1)));
          if Mant >= 0 then B := 1 shl (23 - LogGain)
          else B := Eac3GaqRemapB[Hebap - 8, LogGain - 1] * 256;
          Mant := Mant + Integer(SarInt64(Int64(Eac3GaqRemapA[Hebap - 8, LogGain - 1]) * Mant, 15)) + B;
        end
        else begin
          Mant := Mant * (1 shl (24 - Bits));
          if LogGain = 0 then
            Mant := Mant + Integer(SarInt64(Int64(Eac3GaqRemap1[Hebap - 8]) * Mant, 15));
        end;
        M[Blk] := Mant;
      end;
    end;
    Idct6(M);
    for Blk:=0 to 5 do FPreMant[Ch, Bin, Blk] := M[Blk];
  end;
end;

procedure TAc3Decoder.DecodeChannel(Ch, Blk: Integer);
var Bin: Integer;
begin
  if not FUsesAht[Ch] then begin
    DecodeMantissas(Ch);
    Exit;
  end;
  if Blk = 0 then DecodeAht(Ch);
  for Bin:=FStartF[Ch] to FEndF[Ch]-1 do
    FCoef[Ch, Bin] := FPreMant[Ch, Bin, Blk] * (1 / 8388608) * Power(2, -FExps[Ch, Bin]);
end;

procedure TAc3Decoder.CouplingStrategy(Blk: Integer);
var Ch, CplBegf, CplEndf: Integer;
begin
  if FCplInUse then begin
    if FAcmod < 2 then raise EAc3Error.Create('AC-3 coupling in mono');
    if FEac3 and Get1 then raise EAc3Error.Create('E-AC-3 enhanced coupling is not supported');
    if FEac3 and (FAcmod = 2) then begin
      FChInCpl[1] := True;
      FChInCpl[2] := True;
    end
    else
      for Ch:=1 to FNfchans do FChInCpl[Ch] := Get1;
    if FAcmod = 2 then FPhsFlgInUse := Get1 else FPhsFlgInUse := False;
    CplBegf := GetBits(4);
    if FSpxInUse then CplEndf := (FSpxSrcStart - 37) div 12
    else CplEndf := GetBits(4) + 3;
    if CplBegf >= CplEndf then raise EAc3Error.Create('Invalid AC-3 coupling range');
    FStartF[0] := CplBegf * 12 + 37;
    FEndF[0] := CplEndf * 12 + 37;
    BandStructure(Blk, CplBegf, CplEndf, False, FNumCplBands, FCplBandSize);
  end
  else begin
    for Ch:=1 to FNfchans do begin
      FChInCpl[Ch] := False;
      FFirstCplCoords[Ch] := True;
    end;
    FFirstCplLeak := FEac3;
    FPhsFlgInUse := False;
  end;
end;

procedure TAc3Decoder.DecodeBlock(Blk: Integer);
var Ch, i, Bnd, Seg, CSnr, Snr, Mstr, CoExp, CoMant, GrpSize, AbsExp, Gain_, First: Integer;
    Lo, Hi, Bin, Band, BandEnd, Last: Integer;
    GotCpl, AnyCo, StrategyExists: Boolean;
    T: Single;
    G: Double;
begin
  if FBlkSwSyntax then
    for Ch:=1 to FNfchans do FBlkSw[Ch] := Get1;
  if FDithSyntax then
    for Ch:=1 to FNfchans do FDithFlag[Ch] := Get1;
  // dynamic range (two words for dual mono)
  for i:=Ord(FAcmod = 0) downto 0 do
    if Get1 then FDynRng[i] := DynRngTab[GetBits(8)]
    else if Blk = 0 then FDynRng[i] := 1;

  // spectral extension (E-AC-3)
  if FEac3 and ((Blk = 0) or Get1) then begin
    FSpxInUse := Get1;
    if FSpxInUse then SpxStrategy(Blk);
  end;
  if not FEac3 or not FSpxInUse then begin
    FSpxInUse := False;
    for Ch:=1 to FNfchans do begin
      FChUsesSpx[Ch] := False;
      FFirstSpxCoords[Ch] := True;
    end;
  end;
  if FSpxInUse then SpxCoordinates;

  // coupling strategy
  if FEac3 then begin
    StrategyExists := FCplStrategyExists[Blk];
    FCplInUse := FCplInUseBlk[Blk];
  end
  else begin
    StrategyExists := Get1;
    if StrategyExists then FCplInUse := Get1
    else if Blk = 0 then raise EAc3Error.Create('AC-3 coupling strategy missing in block 0');
  end;
  if StrategyExists then CouplingStrategy(Blk);

  // coupling coordinates
  if FCplInUse then begin
    AnyCo := False;
    for Ch:=1 to FNfchans do
      if FChInCpl[Ch] then begin
        if (FEac3 and FFirstCplCoords[Ch]) or Get1 then begin
          FFirstCplCoords[Ch] := False;
          AnyCo := True;
          Mstr := 3 * GetBits(2);
          for Bnd:=0 to FNumCplBands-1 do begin
            CoExp := GetBits(4);
            CoMant := GetBits(4);
            // mantissa/16 or (mantissa+16)/32, times 8 (A/52 7.4.3)
            if CoExp = 15 then G := CoMant / 2 else G := (CoMant + 16) / 4;
            FCplCo[Ch, Bnd] := G * Power(2, -(CoExp + Mstr));
          end;
        end
        else if Blk = 0 then raise EAc3Error.Create('AC-3 coupling coordinates missing in block 0');
      end
      else FFirstCplCoords[Ch] := True;
    if (FAcmod = 2) and AnyCo then
      for Bnd:=0 to FNumCplBands-1 do
        if FPhsFlgInUse then FPhsFlg[Bnd] := Get1 else FPhsFlg[Bnd] := False;
  end;

  // rematrixing
  if FAcmod = 2 then begin
    if (FEac3 and (Blk = 0)) or Get1 then begin
      FNumRematBands := 4;
      if FCplInUse and (FStartF[0] <= 61) then
        Dec(FNumRematBands, 1 + Ord(FStartF[0] = 37))
      else if FSpxInUse and (FSpxSrcStart <= 61) then
        Dec(FNumRematBands);
      for Bnd:=0 to FNumRematBands-1 do FRematFlg[Bnd] := Get1;
    end
    else if Blk = 0 then FNumRematBands := 0;
  end;

  // exponent strategies
  if FEac3 then begin
    for Ch:=Ord(not FCplInUse) to FChannels do FExpStr[Ch] := FExpStrBlk[Blk, Ch];
  end
  else begin
    if FCplInUse then FExpStr[0] := GetBits(2);
    for Ch:=1 to FNfchans do FExpStr[Ch] := GetBits(2);
    if FLfeOn then FExpStr[FLfeCh] := GetBits(1);
    if Blk = 0 then
      for Ch:=Ord(not FCplInUse) to FChannels do
        if FExpStr[Ch] = EXP_REUSE then raise EAc3Error.Create('AC-3 exponents missing in block 0');
  end;

  // channel bandwidth
  for Ch:=1 to FNfchans do begin
    FStartF[Ch] := 0;
    if FExpStr[Ch] <> EXP_REUSE then begin
      if FChInCpl[Ch] then FEndF[Ch] := FStartF[0]
      else if FChUsesSpx[Ch] then FEndF[Ch] := FSpxSrcStart
      else begin
        i := GetBits(6);
        if i > 60 then raise EAc3Error.Create('Invalid AC-3 bandwidth');
        FEndF[Ch] := i * 3 + 73;
      end;
      GrpSize := 3 shl (FExpStr[Ch] - 1);
      FNumGrps[Ch] := (FEndF[Ch] + GrpSize - 4) div GrpSize;
    end;
  end;
  if FCplInUse and (FExpStr[0] <> EXP_REUSE) then
    FNumGrps[0] := (FEndF[0] - FStartF[0]) div (3 shl (FExpStr[0] - 1));

  // exponents
  for Ch:=Ord(not FCplInUse) to FChannels do
    if FExpStr[Ch] <> EXP_REUSE then begin
      AbsExp := GetBits(4);
      if Ch = 0 then
        DecodeExponents(0, AbsExp shl 1, FStartF[0])
      else begin
        FExps[Ch, 0] := AbsExp;
        DecodeExponents(Ch, AbsExp, 1);
        if Ch <> FLfeCh then GetBits(2);  // gainrng
      end;
    end;

  // bit allocation parameters
  if FBitAllocSyntax then begin
    if Get1 then begin
      FSDecay := Ac3SlowDecay[GetBits(2)];
      FFDecay := Ac3FastDecay[GetBits(2)];
      FSGain := Ac3SlowGain[GetBits(2)];
      FDbKnee := Ac3DbPerBit[GetBits(2)];
      FFloor := Ac3Floor[GetBits(3)];
    end
    else if Blk = 0 then raise EAc3Error.Create('AC-3 bit allocation missing in block 0');
  end;

  // SNR offsets (AC-3: every block with fast gains; E-AC-3: block 0)
  if not FEac3 or (Blk = 0) then begin
    if (FSnrOffsetStrategy <> 0) and Get1 then begin
      CSnr := (GetBits(6) - 15) shl 4;
      First := Ord(not FCplInUse);
      Snr := 0;
      for Ch:=First to FChannels do begin
        if (Ch = First) or (FSnrOffsetStrategy = 2) then Snr := (CSnr + GetBits(4)) shl 2;
        FSnrOffset[Ch] := Snr;
        if not FEac3 then FFastGain[Ch] := Ac3FastGain[GetBits(3)];
      end;
    end
    else if not FEac3 and (Blk = 0) then raise EAc3Error.Create('AC-3 SNR offsets missing in block 0');
  end;

  // fast gains (E-AC-3)
  if FFastGainSyntax and Get1 then begin
    for Ch:=Ord(not FCplInUse) to FChannels do FFastGain[Ch] := Ac3FastGain[GetBits(3)];
  end
  else if FEac3 and (Blk = 0) then
    for Ch:=Ord(not FCplInUse) to FChannels do FFastGain[Ch] := Ac3FastGain[4];

  // converter SNR offset (E-AC-3)
  if FEac3 and (FStrmTyp = 0) and Get1 then GetBits(10);

  // coupling leak
  if FCplInUse then begin
    if FFirstCplLeak or Get1 then begin
      FCplFLeak := GetBits(3);
      FCplSLeak := GetBits(3);
    end;
    FFirstCplLeak := False;
  end;

  // delta bit allocation
  if FDbaSyntax and Get1 then begin
    for Ch:=Ord(not FCplInUse) to FNfchans do begin
      FDbaMode[Ch] := GetBits(2);
      if FDbaMode[Ch] = 3 then raise EAc3Error.Create('Invalid AC-3 delta bit allocation');
    end;
    for Ch:=Ord(not FCplInUse) to FNfchans do
      if FDbaMode[Ch] = DBA_NEW then begin
        FDbaNSegs[Ch] := GetBits(3) + 1;
        for Seg:=0 to FDbaNSegs[Ch]-1 do begin
          FDbaOffset[Ch, Seg] := GetBits(5);
          FDbaLength[Ch, Seg] := GetBits(4);
          FDbaValue[Ch, Seg] := GetBits(3);
        end;
      end;
  end
  else if Blk = 0 then
    for Ch:=0 to 6 do FDbaMode[Ch] := DBA_NONE;

  // skipped data
  if FSkipSyntax and Get1 then begin
    i := GetBits(9);
    if FPos + 8 * i > FEnd then raise EAc3Error.Create('AC-3 frame truncated');
    Inc(FPos, 8 * i);
  end;

  // bit allocation (recomputed every block)
  for Ch:=Ord(not FCplInUse) to FChannels do BitAllocation(Ch);

  // mantissas; the coupling channel follows the first coupled channel
  FB1 := 0; FB2 := 0; FB4 := 0;
  GotCpl := False;
  for Ch:=1 to FChannels do begin
    DecodeChannel(Ch, Blk);
    if FChInCpl[Ch] and (Ch <= FNfchans) then begin
      if not GotCpl then begin
        DecodeChannel(0, Blk);
        GotCpl := True;
      end;
      Last := FEndF[0];
    end
    else Last := FEndF[Ch];
    for Bin:=Last to 255 do FCoef[Ch, Bin] := 0;
  end;

  // decoupling
  if FCplInUse then
    for Ch:=1 to FNfchans do
      if FChInCpl[Ch] then begin
        Bin := FStartF[0];
        for Band:=0 to FNumCplBands-1 do begin
          BandEnd := Bin + FCplBandSize[Band];
          for i:=Bin to BandEnd-1 do begin
            // zero-bit mantissas of channels without dither stay zero
            if (FBap[0, i] = 0) and not FDithFlag[Ch] then FCoef[Ch, i] := 0
            else FCoef[Ch, i] := FCoef[0, i] * FCplCo[Ch, Band];
            if (Ch = 2) and (FAcmod = 2) and FPhsFlg[Band] then FCoef[Ch, i] := -FCoef[Ch, i];
          end;
          Bin := BandEnd;
        end;
      end;

  // rematrixing
  if FAcmod = 2 then begin
    Hi := Min(FEndF[1], FEndF[2]);
    for Bnd:=0 to FNumRematBands-1 do
      if FRematFlg[Bnd] then begin
        Lo := RematBand[Bnd];
        for i:=Lo to Min(Hi, RematBand[Bnd + 1]) - 1 do begin
          T := FCoef[1, i];
          FCoef[1, i] := T + FCoef[2, i];
          FCoef[2, i] := T - FCoef[2, i];
        end;
      end;
  end;

  // dynamic range
  for Ch:=1 to FChannels do begin
    if (FAcmod = 0) and (Ch <= 2) then Gain_ := 2 - Ch else Gain_ := 0;
    if FDynRng[Gain_] <> 1 then
      for i:=0 to 255 do FCoef[Ch, i] := FCoef[Ch, i] * FDynRng[Gain_];
  end;

  // spectral extension (E-AC-3)
  if FSpxInUse then ApplySpx;

  for Ch:=1 to FChannels do Imdct(Ch, Blk);
end;

function TAc3Decoder.DecodeFrame(Data: PByte; Len: Integer): Integer;
var Blk: Integer;
begin
  Result := 0;
  if Len < 6 then raise EAc3Error.Create('AC-3 frame truncated');
  // E-AC-3: only the first independent substream is decoded
  if ((Data[5] shr 3) > 10) and (((Data[2] shr 6) = 1) or (((Data[2] shr 3) and 7) <> 0)) then Exit;
  FData := Data;
  FPos := 0;
  FEnd := Len * 8;
  ParseHeader;
  if FFrameSize < FEnd div 8 then FEnd := FFrameSize * 8;
  if FEac3 then ParseAudioFrame;
  SetLength(FOutput, 256 * FNumBlocks * FChannels);
  for Blk:=0 to FNumBlocks-1 do DecodeBlock(Blk);
  Result := 256 * FNumBlocks;
end;

procedure TAc3Decoder.OutputSilence;
begin
  if FChannels = 0 then raise EAc3Error.Create('AC-3 stream without a valid frame');
  if FNumBlocks = 0 then FNumBlocks := 6;
  SetLength(FOutput, 256 * FNumBlocks * FChannels);
  FillChar(FOutput[0], Length(FOutput) * SizeOf(Single), 0);
end;

function TAc3Decoder.Output: PSingle;
begin
  Result := @FOutput[0];
end;

function TAc3Decoder.Downmix(var Dest: TSingleDynArray; var Count: Int64): Integer;
var i, c, N: Integer;
    L, R, NormL, NormR: Double;
    CL, CR: array[0..4] of Double;
    P: PSingle;
begin
  if FAcmod = 1 then Result := 1 else Result := 2;
  N := 256 * FNumBlocks;
  if Count + N * Result > Length(Dest) then
    SetLength(Dest, Max(Length(Dest) * 2, Count + N * Result + 65536));
  // Lo/Ro coefficients per full bandwidth channel (A/52 7.8.2), LFE is dropped
  FillChar(CL, SizeOf(CL), 0);
  FillChar(CR, SizeOf(CR), 0);
  case FAcmod of
    0, 2: begin CL[0] := 1; CR[1] := 1; end;
    1: begin CL[0] := 1; end;
    3: begin CL[0] := 1; CL[1] := FCmixLev; CR[1] := FCmixLev; CR[2] := 1; end;
    4: begin CL[0] := 1; CR[1] := 1; CL[2] := FSurMixLev * 0.70710678; CR[2] := CL[2]; end;
    5: begin CL[0] := 1; CL[1] := FCmixLev; CR[1] := FCmixLev; CR[2] := 1;
         CL[3] := FSurMixLev * 0.70710678; CR[3] := CL[3]; end;
    6: begin CL[0] := 1; CR[1] := 1; CL[2] := FSurMixLev; CR[3] := FSurMixLev; end;
    7: begin CL[0] := 1; CL[1] := FCmixLev; CR[1] := FCmixLev; CR[2] := 1;
         CL[3] := FSurMixLev; CR[4] := FSurMixLev; end;
  end;
  NormL := 0; NormR := 0;
  for c:=0 to FNfchans-1 do begin
    NormL := NormL + CL[c];
    NormR := NormR + CR[c];
  end;
  if NormL > 0 then NormL := 1 / NormL;
  if NormR > 0 then NormR := 1 / NormR;
  P := @Dest[Count];
  for i:=0 to N-1 do begin
    L := 0; R := 0;
    for c:=0 to FNfchans-1 do begin
      L := L + CL[c] * FOutput[i * FChannels + c];
      R := R + CR[c] * FOutput[i * FChannels + c];
    end;
    if Result = 1 then begin
      P^ := L * NormL;
      Inc(P);
    end
    else begin
      P^ := L * NormL; Inc(P);
      P^ := R * NormR; Inc(P);
    end;
  end;
  Inc(Count, N * Result);
end;

{ raw AC-3 streams }

function DecodeAC3(Str: TStream; out Samples: TSingleDynArray;
  out Channels, SampleRate: Integer; Native: Boolean): Boolean;
var Data: TBytes;
    Dec: TAc3Decoder;
    Pos, Size, Errors, Frames, N: Integer;
    Count: Int64;
    Ok: Boolean;
begin
  Result := False;
  Samples := nil;
  Channels := 0;
  SampleRate := 0;
  SetLength(Data, Str.Size);
  if Length(Data) = 0 then Exit;
  Str.Position := 0;
  Str.ReadBuffer(Data[0], Length(Data));

  Dec := TAc3Decoder.Create;
  try
    Pos := 0;
    Count := 0;
    Errors := 0;
    Frames := 0;
    while Pos + 6 <= Length(Data) do begin
      Size := TAc3Decoder.FrameLength(@Data[Pos], Length(Data) - Pos);
      if (Size = 0) or (Pos + Size > Length(Data)) then begin
        Inc(Pos);   // resynchronize
        Continue;
      end;
      Ok := True;
      N := -1;
      try
        N := Dec.DecodeFrame(@Data[Pos], Size);
        if N = 0 then begin
          // another E-AC-3 substream
          Inc(Pos, Size);
          Continue;
        end;
      except
        on E: EAc3Error do begin
          Ok := False;
          Inc(Errors);
          if (Frames = 0) or ((Errors > 10) and (Errors * 2 > Frames)) then raise;
          Dec.OutputSilence;
        end;
      end;
      if Ok or (Frames > 0) then begin
        if Native then begin
          if Channels = 0 then Channels := Dec.Channels;
          N := Length(Dec.FOutput) div Max(Dec.Channels, 1);
          if Dec.Channels = Channels then begin
            if Count + N * Channels > Length(Samples) then
              SetLength(Samples, Max(Length(Samples) * 2, Count + N * Channels + 65536));
            Move(Dec.Output^, Samples[Count], N * Channels * SizeOf(Single));
            Inc(Count, N * Channels);
          end;
        end
        else begin
          if Channels = 0 then if Dec.Acmod = 1 then Channels := 1 else Channels := 2;
          if (Channels = 1) = (Dec.Acmod = 1) then Dec.Downmix(Samples, Count);
        end;
        if SampleRate = 0 then SampleRate := Dec.SampleRate;
        Inc(Frames);
      end;
      Inc(Pos, Size);
    end;
    SetLength(Samples, Count);
    Result := Count > 0;
  finally
    Dec.Free;
  end;
end;

{ TAudioAC3 }

function TAudioAC3.LoadFromStream(Str: TStream): Boolean;
var Samples: TSingleDynArray;
    Channels, Rate, i, N, V: Integer;
begin
  Result := False;
  if not DecodeAC3(Str, Samples, Channels, Rate) then Exit;
  FHandle.FSampleSize := 16;
  FHandle.FSampleRate := Rate;
  N := Length(Samples) div Channels;
  SetLength(FHandle.FFrames, N);
  for i:=0 to N-1 do begin
    V := EnsureRange(Round(Samples[i*Channels] * 32768), -32768, 32767);
    FHandle.FFrames[i].Left := SignedToSample(V, 16);
    if Channels > 1 then begin
      V := EnsureRange(Round(Samples[i*Channels + 1] * 32768), -32768, 32767);
      FHandle.FFrames[i].Right := SignedToSample(V, 16);
    end
    else
      FHandle.FFrames[i].Right := 0;
  end;
  Result := True;
end;

initialization
  RegisterAudioFormat('ac3', TAudioAC3);
  RegisterAudioFormat('eac3', TAudioAC3);
  RegisterAudioFormat('ec3', TAudioAC3);

end.
