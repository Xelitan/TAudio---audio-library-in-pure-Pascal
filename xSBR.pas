unit xSBR;

{$mode objfpc}{$H+}

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
// Description:	SBR decoder (Spectral Band Replication, ISO/IEC 14496-3       //
//		4.6.18) for HE-AAC, used by xAAC. Doubles the sample rate of //
//		the AAC core and restores the high frequencies.               //
// Version:	0.1                                                           //
// Date:	01-OCT-2026                                                   //
// License:     MIT                                                           //
// Target:	Win64, Free Pascal                                            //
// Copyright:	(c) 2026 Xelitan.com.                                         //
//		All rights reserved.                                          //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

interface

uses SysUtils, Math;

type
  { SBR state of one AAC element (SCE: 1 channel, CPE: 2 channels) }

  TSbrDecoder = class
  private type
    TCplx = record Re, Im: Single; end;
    TChannel = record
      // grid
      FrameClass, LE, LQ, Pointer_, LA, PrevEnvIsShort: Integer;
      TE: array[0..5] of Integer;      // envelope borders in QMF slots
      TQ: array[0..2] of Integer;      // noise floor borders in QMF slots
      F: array[0..5] of Integer;       // frequency resolution per envelope
      FPrev: Integer;
      AmpRes: Integer;
      DfEnv: array[0..4] of Integer;
      DfNoise: array[0..1] of Integer;
      InvfMode, InvfPrev: array[0..4] of Integer;
      BwArray, BwPrev: array[0..4] of Single;
      E: array[0..63, 0..4] of Integer;
      Q: array[0..4, 0..1] of Integer;
      EPrev: array[0..63] of Integer;
      QPrev: array[0..4] of Integer;
      EOrig: array[0..63, 0..4] of Single;
      QDiv, QDiv2: array[0..4, 0..1] of Single;
      AddHarmonic: array[0..63] of Byte;
      AddHarmonicFlag: Boolean;
      SIndexPrev: array[0..63] of Byte;  // sinusoids of the last envelope, per QMF band
      // hf adjustment state
      IndexNoisePrev, IndexSinePrev: Integer;
      GTempPrev, QTempPrev: array[0..4, 0..63] of Single;
      RingIndex: Integer;
      // QMF state
      AnaX: array[0..319] of Single;
      SynV: array[0..1279] of Single;
      XRe, XIm: array[0..39, 0..63] of Single;
    end;
  private
    FCoreRate, FRate: Integer;
    // bit reader
    FData: PByte;
    FPos, FEnd: Integer;
    // header
    FHeaderCount: Integer;
    FAmpRes, FStartFreq, FStopFreq, FXover, FFreqScale, FAlterScale, FNoiseBands: Integer;
    FLimiterBands, FLimiterGains, FInterpolFreq, FSmoothingMode: Integer;
    FPrevHdr: array[0..5] of Integer;
    FReset: Boolean;
    FTablesOk: Boolean;
    // frequency tables
    FK0, FK2, FKx, FM, FKxPrev, FMPrev: Integer;
    FNMaster, FNHigh, FNLow, FNQ: Integer;
    FMaster: array[0..64] of Integer;
    FRes: array[0..1, 0..64] of Integer;   // [0] low, [1] high resolution
    FN: array[0..1] of Integer;
    FNoise: array[0..5] of Integer;
    FMapKtoG: array[0..63] of Integer;
    FNumPatches: Integer;
    FPatchNum, FPatchStart: array[0..5] of Integer;
    FLim: array[0..3, 0..99] of Integer;
    FNL: array[0..3] of Integer;
    // frame data
    FCoupling: Boolean;
    FFrameValid: Boolean;
    FCh: array[0..1] of TChannel;

    function GetBits(N: Integer): Integer;
    function Get1: Integer;
    function Huff(Tree: Integer): Integer;
    procedure ReadHeader;
    function CalcTables: Boolean;
    function MasterTable: Boolean;
    procedure DerivedTables;
    procedure Patches;
    procedure LimiterTables;
    procedure ReadGrid(Ch: Integer);
    procedure ReadDtDf(Ch: Integer);
    procedure ReadInvf(Ch: Integer);
    procedure ReadEnvelope(Ch: Integer);
    procedure ReadNoise(Ch: Integer);
    procedure ReadHarmonics(Ch: Integer);
    procedure SkipExtended;
    procedure Dequantize(Ch: Integer);
    procedure DequantizeCoupled;
    procedure Analysis(Ch: Integer; Input: PSingle; Bands: Integer);
    procedure Synthesis(Ch: Integer; Output: PSingle; Process: Boolean);
    procedure HfGeneration(Ch: Integer);
    procedure HfAdjustment(Ch: Integer);
  public
    constructor Create(CoreSampleRate: Integer);
    { parses sbr_extension_data() starting after the 4 bit extension type;
      BitEnd = first bit after the payload }
    procedure Parse(Data: PByte; BitPos, BitEnd: Integer; Crc, Pair: Boolean);
    { 1024 core samples (16 bit scale) -> 2048 output samples }
    procedure Process(Ch: Integer; Input, Output: PSingle);
    { call after all channels of the element were processed }
    procedure FrameDone(NumChannels: Integer);
    property OutputRate: Integer read FRate;
  end;

implementation

type
  TAacCode = record
    C: Cardinal;
    L: Byte;
  end;
  ESbrError = class(Exception);

